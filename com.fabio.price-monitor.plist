<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fabio.price-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/fabiofeitler/Desktop/whatsapp-mcp/price-monitor.py</string>
    </array>

    <!-- Run every 30 minutes -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/fabiofeitler/Desktop/whatsapp-mcp/price-monitor.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fabiofeitler/Desktop/whatsapp-mcp/price-monitor.log</string>

    <!-- Keep alive on crash -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>

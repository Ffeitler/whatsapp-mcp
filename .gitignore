# --- databases & WhatsApp message store (private data, regenerated at runtime) ---
*.db
store/
# store is a SYMLINK since 2026-09-26 (bridge moved to ~/.claude/whatsapp-bridge);
# a trailing-slash pattern only matches real directories, so name it too.
whatsapp-bridge/store
# pre-relocation rollback copy of the whole store (media + session DB)
whatsapp-bridge/store.pre-relocate-*/

# --- secrets (read from file at runtime, never committed) ---
.seatgeek_client_id
.ticketmaster_api_key
claude_desktop_config.json

# --- compiled Go binary (rebuilt from whatsapp-bridge 2/main.go) ---
whatsapp-bridge/whatsapp-bridge
whatsapp-bridge/whatsapp-bridge.bak-*
whatsapp-bridge 2/whatsapp-bridge
whatsapp-bridge 2/whatsapp-bridge.new

# --- compiled Go binary (rebuilt from claudia-bridge/main.go) ---
claudia-bridge/claudia-bridge

# --- logs ---
*.log
whatsapp.log

# --- macOS cruft ---
.DS_Store
